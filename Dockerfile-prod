FROM python:3.11-bookworm

# --- MATLAB Runtime R2016b + GIFT standalone (computation-specific) ---
ENV MCRROOT=/usr/local/MATLAB/MATLAB_Runtime/v91
ENV MATLAB_RUNTIME=${MCRROOT}
ENV MCR_CACHE_ROOT=/tmp/mcrcache

RUN apt-get update && apt-get install -y \
    curl \
    wget \
    unzip \
    xz-utils \
    libx11-dev \
    libxcomposite-dev \
    libxcursor-dev \
    libxdamage-dev \
    libxext-dev \
    libxfixes-dev \
    libxft-dev \
    libxi-dev \
    libxrandr-dev \
    libxt-dev \
    libxtst-dev \
    libxxf86vm-dev \
    libasound2-dev \
    libatk1.0-dev \
    libcairo2-dev \
    libsndfile1-dev \
    libxcb1-dev \
    libxslt-dev \
    libgtk-3-dev \
    libxrender1 \
    libxt6 \
    libsm6 \
    libxi6 \
    libxmu6 \
    libxinerama1 \
    libglu1-mesa \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir /tmp/mcr_installer && \
    cd /tmp/mcr_installer && \
    wget -q https://ssd.mathworks.com/supportfiles/downloads/R2016b/deployment_files/R2016b/installers/glnxa64/MCR_R2016b_glnxa64_installer.zip && \
    unzip -q MCR_R2016b_glnxa64_installer.zip && \
    ./install -mode silent -agreeToLicense yes && \
    rm -rf /tmp/mcr_installer

# MCR R2016b bundles FreeType 2.6, which lacks FT_Done_MM_Var needed by the
# system libfontconfig; remove it so the distribution's FreeType is used.
RUN rm -f ${MCRROOT}/bin/glnxa64/libfreetype.so.6 \
          ${MCRROOT}/bin/glnxa64/libfreetype.so.6.11.1

RUN mkdir -p /tmp/mcrcache
# --- end MATLAB Runtime ---

# Upgrade pip and setuptools
RUN python3 -m pip install -U pip
RUN python3 -m pip install -U setuptools

# Set working directory
WORKDIR /workspace/

# Copy the requirements.txt file
COPY ./requirements.txt /workspace/requirements.txt

# Install dependencies from requirements.txt
RUN python3 -m pip install -r /workspace/requirements.txt

# --- GIFT toolbox and its nipype interface (computation-specific) ---
COPY ./groupicatv4.0b/icatb/nipype-0.10.0/nipype/interfaces/gift /usr/local/lib/python3.11/site-packages/nipype/interfaces/gift
COPY ./groupicatv4.0b /app/groupicatv4.0b

# Pre-warm the MCR cache so the first real GIFT call doesn't pay cold-start cost
RUN (timeout 20s /app/groupicatv4.0b/GroupICATv4.0b_standalone/run_groupica.sh ${MCRROOT}/; exit 0)

ENV GIFT_HOME=/app/groupicatv4.0b
ENV MATLAB_CMD="${GIFT_HOME}/GroupICATv4.0b_standalone/run_groupica.sh ${MATLAB_RUNTIME}/"
# --- end GIFT ---

# Copy the rest of the application files
COPY ./app/ /workspace/app/
COPY ./system/entry_central.py /workspace/system/entry_central.py
COPY ./system/entry_edge.py /workspace/system/entry_edge.py
COPY ./system/provision/ /workspace/system/provision/
COPY ./system/entry_provision.py /workspace/system/entry_provision.py

# Set environment variables
ENV PYTHONPATH=/workspace/app/code/
ENV DATA_DIR=/workspace/data/
ENV OUTPUT_DIR=/workspace/output/
ENV PARAMETERS_FILE_PATH=/workspace/runKit/parameters.json
